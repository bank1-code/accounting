# Doktra / دكتره ERP - environment template
# Copy to .env and replace every placeholder before running.

NODE_ENV=development
PORT=3000

# MySQL / TiDB connection string
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME

# Local session signing secret; use a long random value in every environment
JWT_SECRET=replace-with-a-long-random-secret

# Local owner bootstrap. The application creates/updates the owner only when both are set.
LOCAL_ADMIN_USERNAME=replace-with-owner-username
LOCAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Retained by the template for optional Manus/OAuth compatibility.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Optional Manus built-in services (storage, maps, image/voice/data helpers).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics placeholders referenced by client/index.html.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
